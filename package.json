{
  "name": "materos-quinieleros",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:server": "node --test server/*.test.mjs",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "check": "npm run format:check && npm run check:text && npm run lint && npm run typecheck && npm test && npm run test:server && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=11.13.0 <12"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@netlify/blobs": "^11.1.6",
    "@primeuix/themes": "2.0.3",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tesseract.js-data/spa": "^1.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.13.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "4.1.12"
  }
}
